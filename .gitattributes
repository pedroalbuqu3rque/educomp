# Keep text changes consistent across Windows, macOS and Linux.
* text=auto
*.md text eol=lf
*.txt text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.html text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.nvmrc text eol=lf
.npmrc text eol=lf

# Do not diff or normalize the binary documents and assets.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.rar binary
